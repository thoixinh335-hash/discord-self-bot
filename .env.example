# Discord — login bằng email + password
DISCORD_EMAIL=your_email@gmail.com
DISCORD_PASSWORD=your_password

# AI Provider: "openai" | "groq" | "gemini"
AI_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible, siêu nhanh, miễn phí)
# Đăng ký key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama3-70b-8192

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Prefix cho lệnh (optional)
BOT_PREFIX=!

# Channel ID được phép auto-reply (để trống = tất cả)
ALLOWED_CHANNEL_IDS=

# User ID được phép tương tác (để trống = tất cả)
ALLOWED_USER_IDS=

# Hệ thống prompt cho AI
SYSTEM_PROMPT=Bạn là một trợ lý AI thân thiện, hữu ích. Trả lời ngắn gọn, tự nhiên bằng tiếng Việt.

# Admin user IDs được phép bật/tắt bot (cách nhau dấu phẩy)
ADMIN_USER_IDS=

# Channel ID để bot gửi thông báo trạng thái (online/offline/lệnh)
NOTIFY_CHANNEL_ID=
